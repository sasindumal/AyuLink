{
    "expo": {
        "name": "AyuLink",
        "slug": "ayulink-patient",
        "version": "0.1.0",
        "scheme": "ayulink-patient",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "backgroundColor": "#F7F0F0",
        "icon": "./assets/icon.png",
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#25671E"
        },
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "lk.ayulink.patient",
            "infoPlist": {
                "NSLocationWhenInUseUsageDescription": "AyuLink uses your location to find the nearest channeling centers."
            }
        },
        "android": {
            "package": "lk.ayulink.patient",
            "edgeToEdgeEnabled": true,
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#FFFFFF"
            },
            "permissions": [
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION"
            ]
        },
        "plugins": ["expo-router", "expo-secure-store", "expo-location", "expo-notifications"]
    }
}
