{
    "expo": {
        "name": "AyuLink Channeling Center",
        "slug": "ayulink-channeling-center",
        "version": "0.1.0",
        "scheme": "ayulink-channeling-center",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "backgroundColor": "#F7F0F0",
        "splash": {
            "backgroundColor": "#25671E"
        },
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "lk.ayulink.channeling-center"
        },
        "android": {
            "package": "lk.ayulink.channelingcenter",
            "edgeToEdgeEnabled": true
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            "expo-notifications"
        ]
    }
}
