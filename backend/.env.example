# This service loads backend/.env (see utils/config.py). Copy this file to
# backend/.env and fill in the values below.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=...
SUPABASE_ANON_KEY=...                     copy from frontend/mobile/patient-app/src/lib/config.ts (SUPABASE_ANON_KEY)

# Neo4j Aura (Knowledge Graph)
NEO4J_URI=...
NEO4J_USERNAME=...
NEO4J_PASSWORD=...
NEO4J_DATABASE=...

# LangGraph checkpointer
AGENTS_CHECKPOINT_DATABASE_URL=postgresql://...   Supabase Dashboard -> Settings -> Database -> Connection string
                                                    -> URI, "Session pooler" or direct (port 5432), NOT "Transaction pooler"

# Which LLM/embedding backend to use — "lm_studio" (local, default) or
# "google" (Google AI Studio / Gemini API). See utils/llm.py.
LLM_PROVIDER=lm_studio

# --- lm_studio provider (used when LLM_PROVIDER=lm_studio) ---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=<model name as loaded in LM Studio>
LM_STUDIO_VISION_MODEL=<vision-capable model name as loaded in LM Studio>
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5   must be an embedding model loaded in LM Studio,
                                                                   separate from LM_STUDIO_MODEL — used for the
                                                                   disease/doctor-finder agents' hybrid symptom
                                                                   retrieval (see seed_neo4j.py, neo4j_tools.py)

# --- google provider (used when LLM_PROVIDER=google) ---
GOOGLE_API_KEY=...                                get one at https://aistudio.google.com/apikey — required if LLM_PROVIDER=google
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_VISION_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
