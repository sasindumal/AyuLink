# This service loads the repo-root .env (see config.py), not a local one.
# The variables below must exist in the repo-root .env file:
#
# Already present in root .env:
#   NEXT_PUBLIC_SUPABASE_URL=...
#   SUPABASE_SERVICE_ROLE_KEY=...   (not used by this service)
#   NEO4J_URI=...
#   NEO4J_USERNAME=...
#   NEO4J_PASSWORD=...
#   NEO4J_DATABASE=...
#
# New variables this service needs added to root .env:
#   SUPABASE_ANON_KEY=...                     copy from mobile/patient-app/src/lib/config.ts (SUPABASE_ANON_KEY)
#   AGENTS_CHECKPOINT_DATABASE_URL=postgresql://...   Supabase Dashboard -> Settings -> Database -> Connection string
#                                                       -> URI, "Session pooler" or direct (port 5432), NOT "Transaction pooler"
#
# Optional (defaults shown), also read from root .env:
#   LM_STUDIO_BASE_URL=http://localhost:1234/v1
#   LM_STUDIO_API_KEY=lm-studio
#   LM_STUDIO_MODEL=<model name as loaded in LM Studio>
#   LM_STUDIO_VISION_MODEL=<vision-capable model name as loaded in LM Studio>
